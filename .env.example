# Browser/PWA configuration.
VITE_APP_VERSION=Alpha Chat 2.0
VITE_BASE_PATH=/

# Alpha 2 intentionally calls Gemini directly from the browser.
# IMPORTANT: every VITE_ value is public in the built JavaScript bundle.
# Restrict this Gemini API key at Google to the intended web origin/API/quota.
VITE_GEMINI_API_KEY=

VITE_SEARCH_ENDPOINT=http://127.0.0.1:5174/api/search
VITE_FETCH_ENDPOINT=http://127.0.0.1:5175/api/fetch-extract

# Search/fetch development services only.
ALPHA_SOURCE_TOKEN_SECRET=
SEARCH_HOST=127.0.0.1
SEARCH_PORT=5174
FETCH_HOST=127.0.0.1
FETCH_PORT=5175
FETCH_MAX_BYTES=2097152
FETCH_HOP_TIMEOUT_MS=8000
FETCH_OVERALL_TIMEOUT_MS=12000
FETCH_MAX_REDIRECTS=3
ALPHA_ALLOWED_ORIGIN=http://localhost:5173
