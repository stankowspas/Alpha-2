# Frontend must never contain secret credentials.
# Public non-secret configuration may use VITE_ variables.
VITE_APP_VERSION=Alpha Chat 2.0
VITE_AI_ENDPOINT=http://127.0.0.1:5177
VITE_BASE_PATH=/
VITE_SEARCH_ENDPOINT=http://127.0.0.1:5174/api/search
VITE_FETCH_ENDPOINT=http://127.0.0.1:5175/api/fetch-extract

# Alpha 2 AI backend. Keep GEMINI_API_KEY server-side only.
ALPHA_AI_PROVIDER=gemini-api
GEMINI_API_KEY=
ALPHA_AI_FIRST_TOKEN_TIMEOUT=60
ALPHA_AI_IDLE_TIMEOUT=20
ALPHA_ALLOWED_ORIGINS=http://localhost:5173

# Search backend only. NEVER prefix secrets with VITE_.
# Shared server-side secret used only to bind a search result to an allowed fetch.
# Use at least 24 random characters in hosted environments. START.bat generates
# a temporary local-development secret automatically.
ALPHA_SOURCE_TOKEN_SECRET=

SEARCH_HOST=127.0.0.1
SEARCH_PORT=5174
FETCH_HOST=127.0.0.1
FETCH_PORT=5175
FETCH_MAX_BYTES=2097152
FETCH_HOP_TIMEOUT_MS=8000
FETCH_OVERALL_TIMEOUT_MS=12000
FETCH_MAX_REDIRECTS=3
ALPHA_ALLOWED_ORIGIN=http://localhost:5173
